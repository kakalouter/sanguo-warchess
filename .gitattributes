# 统一行尾，避免 Windows 上出现 "LF will be replaced by CRLF" 噪音与跨平台 diff 抖动
* text=auto eol=lf

# 明确二进制，避免 git 尝试做行尾转换或文本 diff
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.zip  binary

# 生成产物：折叠 diff（这些文件是单行超长 JSON，展开没有意义）
js/mapdata.js        linguist-generated=true -diff
js/data_generals.js  linguist-generated=true -diff
js/data_portraits.js linguist-generated=true -diff
assets/portraits/index.json -diff

# 让 GitHub 的语言统计不被生成产物带偏
js/mapdata.js linguist-vendored=false
vendor/three.min.js linguist-vendored=true
